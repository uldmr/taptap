{
  "manifest_version": 3,
  "name": "Taptap — annotate any page",
  "version": "0.1.0",
  "description": "Tap an element, write what should change, and hand the page to your AI agent as one prompt. No cloud.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "Annotate this page (Alt+A)",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "toggle-annotations": {
      "suggested_key": { "default": "Alt+A" },
      "description": "Toggle annotation mode"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
